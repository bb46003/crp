  <section class="crp-content crp-tab {{tabs.bio.cssClass}} tab"
  action-data="tab"
  data-group="items"
  data-tab="bio">
<div class="crp-bio">

  <div class="crp-bio-identity">
    <section class="crp-bio-identity-section">
      <h2>Pochodzenie</h2>
      <div class="crp-origin-drop">
        {{#if system.bio.origin.id}}
          <img src="{{system.bio.origin.img}}" class="crp-bio-identity-img">
          <div class="crp-bio-identity-details">
            <strong>{{system.bio.origin.name}}</strong>
            <span><!-- Kliknij, aby otworzyć --></span>
          </div>
          {{#unless characterSheetsLocked}}
            <button type="button"
                    class="crp-origin-clear"
                    data-action="deleteItem"
                    title="Usuń Pochodzenie">✖</button>
          {{/unless}}
        {{else}}
          <div class="crp-bio-identity-empty">
            Przeciągnij tutaj Item typu Pochodzenie
          </div>
        {{/if}}
      </div>
    </section>

    <section class="crp-bio-identity-section">
      <h2>Herb postaci</h2>
      <div class="crp-crest-slot">
        <textarea class="crp-crest-description"
                  name="system.bio.crestDescription"
                  placeholder="Opis herbu">{{system.bio.crestDescription}}</textarea>

        <div class="crp-crest-image-wrap">
          {{#if system.bio.crest}}
            <img src="{{system.bio.crest}}"
                 class="crp-crest-select crp-crest-image"
                 title="Kliknij, aby zmienić herb">
          {{else}}
            <button type="button" class="crp-crest-select crp-crest-empty" data-action="crestSelect">
              Wybierz grafikę herbu
            </button>
          {{/if}}
        </div>
      </div>
    </section>
  </div>

  <div class="crp-languages">
    <section class="crp-language-section">
      <h2>Język ojczysty</h2>
      <div class="crp-language-drop" data-language-role="native">
        {{#if languages.native}}
          <div class="crp-item-row crp-language-row"
               draggable="true"
               data-item-id="{{languages.native.id}}">
            <img src="{{languages.native.img}}" class="crp-item-img">
            <div class="crp-language-details">
              <strong>{{languages.native.name}}</strong>
              <span>Alfabet: {{lookup languages.alphabets languages.native.system.alphabet}}</span>
            </div>
            {{#unless characterSheetsLocked}}
              <button type="button"
                      class="crp-item-delete"
                      data-action="deleteItem"
                      data-item-id="{{languages.native.id}}">✖</button>
            {{/unless}}
          </div>
        {{else}}
          <div class="crp-language-empty">Przeciągnij tutaj język ojczysty</div>
        {{/if}}
      </div>
    </section>

    <section class="crp-language-section">
      <h2>Języki obce {{languages.used}}/{{languages.limit}}</h2>
      <div class="crp-language-drop crp-language-foreign"
           data-language-role="foreign">
        {{#each languages.foreign as |language|}}
          <div class="crp-item-row crp-language-row"
               draggable="true"
               data-item-id="{{language.id}}">
            <img src="{{language.img}}" class="crp-item-img">
            <div class="crp-language-details">
              <strong>{{language.name}}</strong>
              <span>Alfabet: {{lookup ../languages.alphabets language.system.alphabet}}</span>
            </div>
            {{#unless ../characterSheetsLocked}}
              <button type="button"
                      class="crp-item-delete"
                      data-action="deleteItem"
                      data-item-id="{{language.id}}">✖</button>
            {{/unless}}
          </div>
        {{/each}}

        {{#if languages.remaining}}
          <div class="crp-language-empty">Przeciągnij tutaj język obcy</div>
        {{else}}
          {{#unless languages.foreign.length}}
            <div class="crp-language-empty">Brak dostępnych miejsc</div>
          {{/unless}}
        {{/if}}
      </div>      
    </section>
    {{#if languages.unassigned}}
    <section class="crp-language-section">
      <h2>Języki obce nieprzypisane</h2>
            <div class="crp-language-drop crp-language-foreign" data-language-role="unassigned">
            {{#each languages.unassigned as |language|}}
          <div class="crp-item-row crp-language-row"
               draggable="true"
               data-id="{{language.id}}"
               data-toggle="tooltip" data-placement="bottom" title="Kliknij w nazwę Języka żeby przypisać typ">
            <img src="{{language.img}}" class="crp-item-img">
            <div class="crp-language-details">
              <a data-action="assigneLanguageType"><strong>{{language.name}}</strong></a>
              <span>Alfabet: {{lookup ../languages.alphabets language.system.alphabet}}</span>
            </div>
            {{#unless ../characterSheetsLocked}}
              <button type="button"
                      class="crp-item-delete"
                      data-action="deleteItem"
                      data-item-id="{{language.id}}">✖</button>
            {{/unless}}
          </div>
        {{/each}}
            </div>
    </section>
    {{/if}}
  </div>

  <div class="crp-traits">
    <section class="crp-trait-section">
      <div class="crp-trait-header">
        <h2>Zalety: {{traits.advantageUses}}</h2>
        <div class="crp-trait-uses-actions">
          <button type="button"
                  class="crp-add-advantage-use"
                  data-action="addAdvantageUses"
                  title="Dodaj użycie Zalety">
            +
          </button>
          <button type="button"
                  class="crp-use-advantage"
                  data-action="useAdvantageUses"
                  {{#unless traits.advantageUses}}disabled{{/unless}}>
            Użyj
          </button>
        </div>
      </div>
      <div class="crp-trait-drop"
           data-trait-category="advantage">
        {{#each traits.advantages as |trait|}}
          <div class="crp-item-row crp-trait-row"
               draggable="true"
               data-item-id="{{trait.id}}">
            <img src="{{trait.img}}" class="crp-item-img">
            <div class="crp-item-name">{{trait.name}}</div>
            {{#unless ../characterSheetsLocked}}
              <button type="button"
                      class="crp-item-delete"
                      data-action="deleteItem"
                      data-item-id="{{trait.id}}">✖</button>
            {{/unless}}
          </div>
        {{/each}}

        {{#if traits.advantagesRemaining}}
          <div class="crp-trait-empty">Przeciągnij tutaj Zaletę</div>
        {{/if}}
      </div>
    </section>

    <section class="crp-trait-section">
      <h2>Wada</h2>
      <div class="crp-trait-drop"
           data-trait-category="flaw">
        {{#each traits.flaws as |trait|}}
          <div class="crp-item-row crp-trait-row"
               draggable="true"
               data-item-id="{{trait.id}}">
            <img src="{{trait.img}}" class="crp-item-img">
            <div class="crp-item-name">{{trait.name}}</div>
            {{#unless ../characterSheetsLocked}}
              <button type="button"
                      class="crp-item-delete"
                      data-action="deleteItem"
                      data-item-id="{{trait.id}}">✖</button>
            {{/unless}}
          </div>
        {{/each}}

        {{#if traits.flawsRemaining}}
          <div class="crp-trait-empty">Przeciągnij tutaj Wadę</div>
        {{/if}}
      </div>
    </section>
  </div>

  <div class="crp-bio-header">
  <h2>Opis</h2>
  </div>

  <div class="crp-bio-content">
      {{formInput
    description.field
    value=description.value
    enriched=description.enriched
    toggled="true"
  }}
  </div>

</div>
  </section>