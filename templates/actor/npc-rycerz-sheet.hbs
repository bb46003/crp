<section class="crp--sheet">
<header class="crp-header">
  <!-- PORTRET -->
  <div class="crp-portrait">
    <img src="{{document.img}}" data-edit="img" data-action="editImage">
  </div>
  <!-- ŚRODEK -->
  <div class="crp-header-main">
      <h1 class="crp-name" contenteditable="true">        
        <input type="text" name="name" value="{{actor.name}}">
        </h1>
<div class="crp-stats npc">
  <div class="crp-stat">
          <label>Zdrowie</label>
          <div class="crp-health-values">
            <input type="number" 
                   name="system.derived.health.value"
                   value="{{system.derived.health.value}}">
            /
            <input type="number"
                   class="crp-pd-value"
                   name="system.derived.health.max"
                   value="{{system.derived.health.max}}"
                   {{#if npcSheetLocked}}disabled{{/if}}>
          </div>
                    <div class="crp-health-bar">
            <div class="crp-health-fill {{system.derived.woundState}}"
                 style="width: {{system.derived.health.percent}}%;">
            </div>
          </div>
  </div>
  <div class="crp-stat">
    <label>Atrybuty</label>
    <div class="crp-health-values">
      <input type="number"
             name="system.npc.attributes"
             value="{{system.npc.attributes}}"
             {{#if npcSheetLocked}}disabled{{/if}}>
    </div>
    <a type="button" class="crp-roll-initiative crp-roll-npc-attributes">Rzuć</a>
  </div>
  <div class="crp-stat">
    <label>Ochrona</label>
    <div class="crp-stat-value crp-protection-value">
      <span class="crp-protection-total">{{system.npc.protection}}</span>
      <span class="crp-protection-components">
      <span class="crp-initiative-mod">
        {{protection.armor}}
        <i class="fa-solid fa-shirt" title="Redukcja z pancerza"></i>
      </span>
      <span class="crp-initiative-mod">
        + {{protection.shield}}
        <i class="fa-solid fa-shield-halved" title="Redukcja z tarczy"></i>
      </span>
      </span>
    </div>
  </div>
  <div class="crp-stat">
    <label>Inicjatywa</label>
    <div class="crp-stat-value crp-initiative-value">
      <span>{{system.derived.initiative}}</span>
      <span class="crp-initiative-mod">
        {{initiative.weaponModifierText}}
        <i class="fa-solid fa-sword" title="Modyfikator z broni"></i>
      </span>
      <span class="crp-initiative-mod">
        {{initiative.armorModifierText}}
        <i class="fa-solid fa-shirt" title="Modyfikator z pancerza"></i>
      </span>
    </div>
    <a class="crp-roll-initiative" data-action="rollInitiative">Rzuć</a>
  </div>
  <div class="crp-stat">
    <label>Karta</label>
    <a type="button" class="crp-roll-initiative crp-npc-sheet-lock" data-action="lockSheet">
      {{#if npcSheetLocked}}Odblokuj kartę{{else}}Zablokuj kartę{{/if}}
    </a>
  </div>
</div>
</div>
  <!-- TOKEN -->
  <div class="crp-token">
    <img src="{{tokenImg}}" data-action="editImage" 
    {{#if isToken}}
      data-edit="document.parent.texture.src"
    {{else}}
      data-edit="prototypeToken.texture.src"
    {{/if}}>
  </div>
</header>
<nav class="crp-tabs tabs" data-group="items">
  <a class="crp-tab-btn {{tabs.attributes.cssClass}}" data-action="tab" data-tab="attributes" data-group="items">
    Karta
  </a>
  <a class="crp-tab-btn {{tabs.equipment.cssClass}}" data-action="tab" data-tab="equipment" data-group="items">
    Ekwipunek
  </a>
    <a class="crp-tab-btn {{tabs.bio.cssClass}}" data-action="tab" data-tab="bio" data-group="items">
    Biografia
  </a>
</nav>
</section>

