<section class="crp--sheet">

<header class="crp-header">

  <!-- PORTRET -->
  <div class="crp-portrait">
    <img src="{{actor.img}}" data-edit="img" data-action="editImage">
  </div>

  <!-- ŚRODEK -->
  <div class="crp-header-main">
      <h1 class="crp-name" contenteditable="true" data-edit="name">
        <input type="text" name="name" value="{{actor.name}}">
      </h1>


<div class="crp-stats">

  <div class="crp-stat">
          <label>Zdrowie</label>



          <div class="crp-health-values">
            <input type="number" 
                   name="system.derived.health.value"
                   value="{{system.derived.health.value}}">
            / {{system.derived.health.max}}
          </div>
                    <div class="crp-health-bar" data-toggle="tooltip" data-placement="bottom" title="Kary za rany to {{woundPenalty}}">
            <div class="crp-health-fill {{system.derived.woundState}}"
                 style="width: {{healthPercent}}%;" >
            </div>
          </div>

  </div>

  <div class="crp-stat">
    <label>Dola</label>
    <div class="crp-stat-value">
      {{system.resources.fate.value}} / {{system.resources.fate.max}}
    </div>
  </div>

    <div class="crp-stat">
    <label>Manewry</label>
    <div class="crp-stat-value">
      {{system.derived.maneuver.value}} / {{system.derived.maneuver.max}}
    </div>
  </div>

  <div class="crp-stat">
    <label>Inicjatywa</label>
    <div class="crp-stat-value crp-initiative-value">
      <span>{{system.initiative}}</span>
      <span class="crp-initiative-mod">
        {{initiative.weaponModifierText}}
        <i class="fa-solid fa-sword" title="Modyfikator z broni"></i>
      </span>
      <span class="crp-initiative-mod">
        {{initiative.armorModifierText}}
        <i class="fa-solid fa-shirt" title="Modyfikator z pancerza"></i>
      </span>
    </div>
    <button class="crp-roll-initiative" data-action="rollInitiative">Rzuć</button>
  </div>



  <div class="crp-stat">
          <label>PD</label>
          <div class="crp-health-values">
            <input type="number"
                   class="crp-pd-value"
                   name="system.resources.experience.free"
                   value="{{system.resources.experience.free}}"
                   {{#if characterSheetsLocked}}disabled{{/if}}>
            /
            <input type="number"
                   class="crp-pd-value"
                   name="system.resources.experience.value"
                   value="{{system.resources.experience.value}}"
                   {{#if characterSheetsLocked}}disabled{{/if}}>
          </div>
            <button class="crp-exp" data-action="advancement">Wydaj PD</button>
  </div>

</div>

    </div>
  <!-- TOKEN -->
  <div class="crp-token">
    <img src="{{actor.prototypeToken.texture.src}}" data-action="editImage" data-edit="prototypeToken.texture.src">
  </div>

</header>

<nav class="crp-tabs tabs" data-group="items">

  <a class="crp-tab-btn {{tabs.attributes.cssClass}}" data-action="tab" data-tab="attributes" data-group="items">
    Karta
  </a>

  <a class="crp-tab-btn {{tabs.equipment.cssClass}}" data-action="tab" data-tab="equipment" data-group="items">
    Ekwipunek
  </a>

  <a class="crp-tab-btn {{tabs.bio.cssClass}}" data-action="tab" data-tab="bio" data-group="items">
    Biografia
  </a>

</nav>



</section>
