
<div class="crp-roll-card {{#if data.success}}success{{else}}fail{{/if}}">
  <div class="crp-roll-header">
    <img src="{{data.actor.img}}" class="crp-roll-avatar">
    <div>
      <div class="crp-roll-actor">{{data.actor.name}}</div>
      <div class="crp-roll-skill">{{data.rollLabel}}</div>
    </div>
  </div>

  <div class="crp-roll-body">
    <div class="crp-roll-dice">
      🎲 {{lookup data.dice 0}},{{lookup data.dice 1}}
      → <strong>{{data.total}}</strong>
    </div>

    <div class="crp-roll-target"           data-toggle="tooltip" 
          data-placement="bottom" 
          title="{{modifierTooltip data.modyfiers}}">
      🎯 Cel: {{data.modyfiers.target}} (Całkowity Modyfikator {{data.modyfiers.totalMod}})
    </div>
    <div class="crp-roll-result"></div>
      <div class="crp-roll-margin">
        Margin: {{data.margin}}
      </div>
  

{{#if data.showSymbols}}
  <div class="crp-roll-symbols">
    {{#if (ne data.eagles 0)}}
    <label>Ilość</label>
      <span class="crp-dice-icon crp-dice-eagle">
        <img
          src="systems/crp/assets/orzel-kostka.webp"
          alt="Orzeł"
          title="Orzeł"
        >
      </span>
      
        <label>:{{data.eagles}}</label>
    {{/if}}

    {{#if (ne data.shields 0)}}
    <label>Ilość</label>
      <span class="crp-dice-icon crp-dice-shield">
                <img
          src="systems/crp/assets/tarcza_kostka.webp"
          alt="Tarcza"
          title="Tarcza"
        >      
      </span>
        <label>:{{data.shields}}<label>
    {{/if}}
  </div>
{{/if}}
<div class="crp-result">
  <strong>{{data.resultsText}}</strong>
  </div>
    {{#if data.allowFate}}
      <button
        class="crp-use-fate" data-action="useFate" data-type="skillRoll" {{#if data.reRoll}}disabled{{/if}}>
          ✨ Użyj Doli
      </button>
    {{/if}}

  </div>
</div>
