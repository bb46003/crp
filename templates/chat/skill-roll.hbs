
<div class="crp-roll-card {{#if success}}success{{else}}fail{{/if}}">

  <div class="crp-roll-header">
    <img src="{{actor.img}}" class="crp-roll-avatar">
    <div>
      <div class="crp-roll-actor">{{actor.name}}</div>
      <div class="crp-roll-skill">{{rollLabel}}</div>
      {{#if reRoll}}
        <div class="crp-roll-reroll">Wykorzystano dole do przerzutu</div>
      {{/if}}
    </div>
  </div>

  <div class="crp-roll-body">
    <div class="crp-roll-dice">
      🎲 {{diceDisplay}}
      → <strong>{{total}}</strong>
    </div>

    <div class="crp-roll-target">
      🎯 Cel: {{target}}{{modifierText}}
    </div>

    {{#if showWoundPenalty}}
      <div class="crp-roll-penalty">
        ⚠ Kara za rany: {{woundPenalty}}
      </div>
    {{/if}}

    {{#if showArmorPenalty}}
      <div class="crp-roll-penalty">
        ⚠ Kara za pancerz: -{{armorPenalty}}
      </div>
    {{/if}}
    {{#if (ne displayModifier 0)}}
    <div class="crp-roll-penalty">
        Dodatkowy Modyfikator: {{customMod}}
    </div>
    {{/if}}
    <div class="crp-roll-result">{{resultText}}</div>

    {{#if showMargin}}
      <div class="crp-roll-margin">
        Margin: {{marginText}}
      </div>
    {{/if}}

{{#if showSymbols}}
  <div class="crp-roll-symbols">
    {{#if showEagles}}
    <label>Ilość</label>
      <span class="crp-dice-icon crp-dice-eagle">
        <img
          src="systems/crp/assets/orzel-kostka.webp"
          alt="Orzeł"
          title="Orzeł"
        >
      </span>
      
        <label>:{{eagles}}</label>
    {{/if}}

    {{#if showShields}}
    <label>Ilość</label>
      <span class="crp-dice-icon crp-dice-shield">
                <img
          src="systems/crp/assets/tarcza_kostka.webp"
          alt="Tarcza"
          title="Tarcza"
        >      
      </span>
        <label>:{{shields}}<label>
    {{/if}}
  </div>
{{/if}}

    {{#if canUseFate}}
      <button
        class="crp-use-fate" data-action="useFate" data-type="skillRoll">
          ✨ Użyj Doli
      </button>
    {{/if}}

  </div>
</div>
