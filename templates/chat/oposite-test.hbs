{{log this}}
<div class="crp-oposite-roll">
   {{> "systems/crp/templates/chat/skill-roll.hbs" this.atackerRoll}}
  {{#if defenderRoll}}
  {{else}}
  <div class="crp-oponent-test">
    <label>Oponent {{defender.name}} może wykonać test:</label>
    {{#each defender.defenderSkillKey as |skill|}}
      <button class="crp-button" data-skill="{{skill}}">Test Przeciwstawny na {{localize (concat "CRP.skills." skill)}}</button>
    {{/each}}
  </div>
  {{/if}}
</div>