{{log this}}
<div class="crp-oposite-roll">
  <div class="crp-attaker">
   {{> "systems/crp/templates/chat/skill-roll.hbs" this.atackerRoll}}

  </div>
   {{#if defenderRoll}}
  <div class="crp-defender">
 
       {{> "systems/crp/templates/chat/skill-roll.hbs" this.defenderRoll}}

  </div>
   {{else}}
  <div class="crp-oponent-test">
    <label>Oponent {{defender.defenderName}} może wykonać test:</label>
    {{#each defender.defenderSkillKey as |skill|}}
      <button class="crp-button" data-action="opositeTest" data-skill="{{skill}}">Test Przeciwstawny na {{localize (concat "CRP.skills." skill)}}</button>
    {{/each}}
  </div>
  {{/if}}
  {{#if results}}
  {{log results}}
  <div class="crp-results">
    {{#if (eq results "A")}}
      <label>Wygtywa {{attacker.actor.name}}</label>
    {{else}}
      {{#if (eq results "B")}}
      <label>Wygtywa {{defender.defenderName}}</label>
      {{else}}
      <label>Ramis!</label>
      {{/if}}
    {{/if}}
  </div>
  {{/if}}
</div>