<div class="crp-defense-choice">
  <p class="crp-atak-roll">
    <strong>Atakujący: {{atackRoll.name}}</strong><br>
    <label>Wynik Testu Ataku {{#if atackRoll.reRoll}}po Użyciu Doli{{/if}}:</label><br>
    {{atackRoll.skill}} ({{atackRoll.attr}})<br>
    🎲 {{lookup atackRoll.dice 0}}, {{lookup atackRoll.dice 1}} = {{atackRoll.total}}<br>
    Cel: {{atackRoll.target}}
    {{#if (gte atackRoll.displayModifier 0)}}
      (Modyfikator +{{atackRoll.displayModifier}})
    {{else}}
      (Modyfikator {{atackRoll.displayModifier}})
    {{/if}}
    <br>
    {{#if atackRoll.rany}}
    ⚠ Kara za rany: {{atackRoll.karaRany}}<br>
    {{/if}}
    {{#if atackRoll.pancerz}}
    ⚠ Kara za pancerz: -{{atackRoll.armorPenaltyValue}}<br>
    {{/if}}
    Margin: {{atackRoll.margin}}<br>
  </p>
  {{#if atackRoll.allowFate}}
    <button
    type="button"
    class="crp-use-fate"
    data-action="useFate"
    data-type="atackRoll">
    ✨ Użyj Doli
  </button>
  {{/if}}
 {{#if defenseChoice.defenceChoice}}
  <p>Wybierz obronę:</p>

  <button
    data-defense="parry"
    data-action="defenseChoice"
    {{#if (or defenseChoice.canParry defenseChoice.isRangedAttack)}}disabled{{/if}}>
    Parowanie
  </button>

  <button data-defense="dodge" data-action="defenseChoice">
    Unik{{#if defenseChoice.defenderMounted}} (-2){{/if}}
  </button>

  <button
    data-defense="shield" data-action="defenseChoice"
    {{#if defenseChoice.hasShield}}disabled{{/if}}>
    Tarcza
  </button>
{{else}}
  <p class="crp-defence-roll">
    <label>{{defenseResult.label}}</label>
    <strong>Broniący: {{defenceRoll.name}}</strong><br>
    <label>Wynik Testu Obrony:</label><br>
    {{defenceRoll.skill}} ({{defenceRoll.attr}})<br>
    🎲 {{lookup defenceRoll.dice 0}}, {{lookup defenceRoll.dice 1}} = {{defenceRoll.total}}<br>
    Cel: {{defenceRoll.target}}
    {{#if (gte defenceRoll.displayModifier 0)}}
      (Modyfikator +{{defenceRoll.displayModifier}})
    {{else}}
      (Modyfikator {{defenceRoll.displayModifier}})
    {{/if}}
    <br>
    {{#if defenceRoll.rany}}
    ⚠ Kara za rany: {{defenceRoll.karaRany}}<br>
    {{/if}}
    {{#if defenceRoll.pancerz}}
    ⚠ Kara za pancerz: -{{defenceRoll.armorPenaltyValue}}<br>
    {{/if}}
    Margin: {{defenceRoll.margin}}<br>
      {{#if defenceRoll.allowFate}}
    <button
    type="button"
    class="crp-use-fate"
    data-action="useFate"
    data-action="useFate"
    data-type="defenceRoll">
    ✨ Użyj Doli
  </button>
  {{/if}}
  </p>
  {{#if (eq winner "A")}}
    <label class="crp-winner">👉 Wygrywa atakujący {{atackRoll.name}} </label>
  {{else}}
    {{#if (eq winner "B")}}
      <label class="crp-winner">👉 Wygrywa broniący {{defenceRoll.name}} </label>
    {{else}}
      <label class="crp-winner">👉 Remis</label>
    {{/if}}
  {{/if}}
  {{/if}}
  {{#if damageResult}}
  <div class="crp-dmg">
    💥 Obrażenia bazowe: <b>{{damageResult.base}}</b><br>
    🛡 Redukcja: {{damageResult.reduction}}
    (
    {{#if (ne damageResult.armorProtection 0)}}
    + {{damageResult.armorProtection}} pancerz
    {{/if}}
    {{#if (ne damageResult.shieldProtection 0)}}
    + {{damageResult.shieldProtection}} tarcza
    {{/if}}
    {{#if (ne defenceRoll.eagles 0)}}
    + {{defenceRoll.eagles}} 🦅
    {{/if}}
    {{#if (ne defenceRoll.eagles 0)}}
     - {{defenceRoll.eagles}} 🛡️
    {{/if}}
    )<br>
  ⚔ Modyfikator ataku:
    {{#if (ne atackRoll.eagles 0)}}+{{atackRoll.eagles}}🦅{{/if}}
    {{#if (ne atackRoll.shields 0)}}-{{atackRoll.eagles}}🛡️{{/if}}<br>
    👉 Obrażenia końcowe: <b>{{damageResult.total}}</b>
  </div>
  {{/if}}
  {{#if damageResult.needsDamageChoice}}<!-- CRP_DAMAGE_CONTROL_START -->
  <div class="crp-damage-control">
    <button type="button" data-action="applyDamage">
      Przyjmij obrażenia
    </button>
    <button type="button" data-action="avoidDamage">
      Anuluj obrażenia
    </button>
    <div class="crp-damage-status">{note}</div>
  </div>
  {{/if}}
<!-- CRP_DAMAGE_CONTROL_END -->
</div>